# 采集服务环境变量（服务器/容器部署用，复制为 .env 后改名或直接 export）
# 有了这些变量就不需要 config.json 了

# ---- 基础 ----
PORT=8787
HOST=127.0.0.1
INTERVAL=300
TZ=Asia/Shanghai
NODE_OPTIONS=--no-warnings
# 直接跑 Node（systemd）：填绝对路径；Docker 部署请改成 /app/realtime/data（映射自宿主机 ./realtime/data）
DATA_DIR=/opt/media-monitor/realtime/data

# ---- 数据源 ----
# adapter: file | http | official | none
ADAPTER=http
PLATFORM=douyin
URL=https://服务商域名/api/works?date={date}&page={page}
ITEMS_PATH=data.list
PAGES=3
PAGESIZE=50
AUTH_HEADER=Bearer 你的密钥
# TOKEN_HEADER=
# ENDPOINTS_TOKEN=
# ENDPOINTS_LIST=
# CLIENT_KEY=
# CLIENT_SECRET=
# ACCESS_TOKEN=

# ---- 安全 ----
# 公网部署务必设置，推送数据和清空数据都要带这个 token
INGEST_TOKEN=换成一段随机长字符串

# ---- 告警推送 ----
NOTIFY_ENABLED=false
NOTIFY_FORMAT=wecom
NOTIFY_WEBHOOK=
PUBLIC_URL=https://monitor.example.com/
